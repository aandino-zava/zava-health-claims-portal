      "post": {
        "operationId": "createClaim",
        "summary": "Submit a synthetic claim",
        "description": "Create a fictitious claim with Claims.Writer. Generate an Idempotency-Key for each new submission; reuse it only to retry the identical payload. A replay returns 200, a new record 201, and conflicting reuse 409. Never submit real patient information.",
        "x-ms-summary": "Submit a synthetic claim",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "Unique submission key (8-128 characters). Reuse only for an identical retry by the same caller."
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Synthetic claim fields.",
